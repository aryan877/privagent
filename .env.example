# Solana RPC Configuration
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Agent Seeds (use different secure phrases for production)
COORDINATOR_SEED=privagent_coordinator_seed_phrase_change_me
PRIVACY_AGENT_SEED=privagent_privacy_seed_phrase_change_me
EXECUTION_AGENT_SEED=privagent_execution_seed_phrase_change_me
MONITORING_AGENT_SEED=privagent_monitoring_seed_phrase_change_me

# Agent Configuration
AGENT_PORT_COORDINATOR=8000
AGENT_PORT_PRIVACY=8001
AGENT_PORT_EXECUTION=8002
AGENT_PORT_MONITORING=8003

# Light Protocol CLI Path (optional - uses system PATH by default)
LIGHT_CLI_PATH=light

# Network (mainnet-beta, devnet, testnet)
SOLANA_NETWORK=mainnet-beta
