# ============================================================================
# LLM Configuration (Required for Agent Routing)
# ============================================================================
# Provider: openai, asi1, or anthropic
LLM_PROVIDER= 
LLM_API_KEY= # ⚠️ REPLACE with OpenAI key from https://platform.openai.com/api-keys

# For OpenAI (default)
LLM_MODEL= 
# LLM_BASE_URL=https://api.openai.com/v1

# For ASI:One 
# LLM_PROVIDER=asi1
# LLM_API_KEY=your-asi1-api-key
# LLM_MODEL=asi1-mini
# LLM_BASE_URL=https://api.asi1.ai/v1

# LLM Settings
LLM_TEMPERATURE= 
LLM_MAX_TOKENS= 
LLM_TIMEOUT_SECONDS= 
LLM_MAX_RETRIES= 

# ============================================================================
# Blockchain Configuration
# ============================================================================
BLOCKCHAIN_HELIUS_RPC_URL= # ✅ CONFIGURED
BLOCKCHAIN_SOLANA_RPC_URL= 
BLOCKCHAIN_SOLANA_NETWORK= 

# ============================================================================
# Token Configuration
# ============================================================================
TOKEN_USDC_MINT= 
TOKEN_USDT_MINT= 
TOKEN_SOL_MINT= 
TOKEN_DEFAULT_COMPRESSION_AMOUNT= 

# ============================================================================
# CLI Configuration
# ============================================================================
CLI_LIGHT_CLI_PATH= 
LIGHT_CLI_PATH= 
CLI_TIMEOUT_SECONDS= 
CLI_MAX_CLI_EXECUTIONS_PER_HOUR= 
CLI_FALLBACK_TO_API= 

# ============================================================================
# Agent Seeds & Ports
# ============================================================================
COORDINATOR_SEED= 
PRIVACY_AGENT_SEED= 
EXECUTION_AGENT_SEED= 
MONITORING_AGENT_SEED= 

AGENT_PORT_COORDINATOR= 
AGENT_PORT_PRIVACY= 
AGENT_PORT_EXECUTION= 
AGENT_PORT_MONITORING= 

# ============================================================================
# Published Agent Addresses (optional overrides)
# ============================================================================
# These will be auto-generated from seeds on first run
# Copy agent addresses here after first deployment for hardcoded routing
COORDINATOR_AGENT_ADDRESS= 
PRIVACY_AGENT_ADDRESS= 
EXECUTION_AGENT_ADDRESS= 
MONITORING_AGENT_ADDRESS= 

# ============================================================================
# Execution Agent Configuration
# ============================================================================
EXECUTION_JUPITER_API_KEY= 
EXECUTION_MAX_PRIORITY_FEE= 
JUPITER_TIMING_JITTER= 
JUPITER_ROUTE_OBFUSCATION= 

# ============================================================================
# Wallet Configuration - CLIENT-SIDE SIGNING MODEL
# ============================================================================
# 🔒 SECURITY MODEL: Backend does NOT hold private keys
# All transactions are returned unsigned for client-side wallet signing
# This eliminates custody risk and follows Web3 security best practices
#
# Users sign transactions in their browser wallet (Phantom, Solflare, etc.)
# Wallet signature = proof of ownership (no separate authentication needed)
#
# Legacy backend wallet configuration (DISABLED):
# PAYER_KEYPAIR_PATH=
# PAYER_PRIVATE_KEY=
#
# ⚠️ Note: If you need backend signing for testing, uncomment above variables
# Production deployments should ALWAYS use client-side signing

# ============================================================================
# Privacy Agent Configuration
# ============================================================================
PRIVACY_AGENT_PORT= 
PRIVACY_DEFAULT_PRIVACY_LEVEL= 
PRIVACY_ENABLE_METTA_ENGINE= 

# ============================================================================
# Security Configuration
# ============================================================================
SECURITY_ENABLE_RATE_LIMITING= 
SECURITY_CIRCUIT_BREAKER_THRESHOLD= 
SECURITY_MAX_REQUESTS_PER_WINDOW= 

# ============================================================================
# Monitoring Configuration
# ============================================================================
MONITORING_ALERT_COOLDOWN_MINUTES= 
MONITORING_DEFAULT_PRIVACY_THRESHOLD= 
