# ============================================================================
# LLM Configuration (Required for Agent Routing)
# ============================================================================
# Provider: openai, asi1, or anthropic
LLM_PROVIDER= 
LLM_API_KEY= # ⚠️ REPLACE with OpenAI key from https://platform.openai.com/api-keys

# For OpenAI (default)
LLM_MODEL= 
# LLM_BASE_URL=https://api.openai.com/v1

# For ASI:One 
# LLM_PROVIDER=asi1
# LLM_API_KEY=your-asi1-api-key
# LLM_MODEL=asi1-mini
# LLM_BASE_URL=https://api.asi1.ai/v1

# LLM Settings
LLM_TEMPERATURE= 
LLM_MAX_TOKENS= 
LLM_TIMEOUT_SECONDS= 
LLM_MAX_RETRIES= 

# ============================================================================
# Blockchain Configuration
# ============================================================================
BLOCKCHAIN_HELIUS_RPC_URL= # ✅ CONFIGURED
BLOCKCHAIN_SOLANA_RPC_URL= 
BLOCKCHAIN_SOLANA_NETWORK= 

# ============================================================================
# Token Configuration
# ============================================================================
TOKEN_USDC_MINT= 
TOKEN_USDT_MINT= 
TOKEN_SOL_MINT= 
TOKEN_DEFAULT_COMPRESSION_AMOUNT= 

# ============================================================================
# CLI Configuration
# ============================================================================
CLI_LIGHT_CLI_PATH= 
LIGHT_CLI_PATH= 
CLI_TIMEOUT_SECONDS= 
CLI_MAX_CLI_EXECUTIONS_PER_HOUR= 
CLI_FALLBACK_TO_API= 

# ============================================================================
# Agent Seeds & Ports
# ============================================================================
COORDINATOR_SEED= 
PRIVACY_AGENT_SEED= 
EXECUTION_AGENT_SEED= 
MONITORING_AGENT_SEED= 

AGENT_PORT_COORDINATOR= 
AGENT_PORT_PRIVACY= 
AGENT_PORT_EXECUTION= 
AGENT_PORT_MONITORING= 

# ============================================================================
# Published Agent Addresses (Deterministic from seeds)
